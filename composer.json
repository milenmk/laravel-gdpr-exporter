{
  "name": "milenmk/laravel-gdpr-exporter",
  "description": "A GDPR-compliant user data exporter with Livewire support.",
  "type": "library",
  "version": "1.2.0",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Milenmk\\LaravelGdprExporter\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Milenmk\\LaravelGdprExporter\\GDPRExporterServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Milen Karaganski",
      "email": "milenmk@gmail.com"
    }
  ],
  "repository": [
    {
      "type": "git",
      "url": "https://github.com/milenmk/laravel-gdpr-exporter"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "illuminate/contracts": "^10.0|^11.0|^12.0",
    "livewire/livewire": "^3.0|dev-main",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "tightenco/duster": "^2.7"
  },
  "conflict": {
    "laravel/framework": "<10.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
